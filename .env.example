# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ticketingDB

# Redis Cache & Lockout Store (optional, falls back to memory if disconnected)
REDIS_URL=redis://127.0.0.1:6379

# Session Security
SESSION_SECRET=change-this-to-a-secure-random-32-char-secret

# Admin Secret Key (required for admin signup and role elevation)
ADMIN_SECRET=change-this-to-a-secure-admin-secret-key

# Password Pepper (secret key stored outside database to salt-and-pepper password hashes)
PASSWORD_PEPPER=change-this-to-a-cryptographically-secure-random-64-character-pepper-key

# Email Service (optional: for lockout alerts and password reset links)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="TicketHub Security" <security@ticketing-app.com>
